{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Condition",
  "type": "object",
  "description": "Represents a logical condition",
  "not": {
    "required": [
      "and",
      "or"
    ],
    "properties": {
      "and": {
        "type": "array"
      },
      "or": {
        "type": "array"
      }
    }
  },
  "additionalProperties": false,
  "properties": {
    "not": {
      "type": "boolean",
      "description": "If true, this condition is inverted"
    },
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Compare property values",
          "$ref": "#/definitions/Value"
        }
      ]
    },
    "and": {
      "type": [
        "array",
        "null"
      ],
      "description": "Require all of these conditions to be met",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#"
          }
        ]
      }
    },
    "or": {
      "type": [
        "array",
        "null"
      ],
      "description": "Require at least one of these conditions to be met",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#"
          }
        ]
      }
    },
    "event": {
      "description": "Check if an event has occurred",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/EventCondition"
        }
      ]
    },
    "date": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Check if a date has passed",
          "$ref": "#/definitions/Date"
        }
      ]
    },
    "deadline": {
      "description": "Check if a deadline has not yet passed. Use a step's deadline setting for soft/hard submission deadlines.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/DeadlineCondition"
        }
      ]
    },
    "name": {
      "type": [
        "null",
        "string"
      ],
      "description": "Use a named reusable condition"
    },
    "message": {
      "description": "Message that is shown then the condition is not, for use in form validation",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/BilingualString"
        }
      ]
    }
  },
  "definitions": {
    "Value": {
      "title": "Value",
      "type": "object",
      "description": "Represents a value comparison. Use this to compare two properties, or to compare a property to a fixed literal value\n            (prefix a string value with an equals sign to indicate a literal value)",
      "additionalProperties": false,
      "required": [
        "property"
      ],
      "properties": {
        "property": {
          "type": "string",
          "description": "Target property"
        },
        "equal": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be equal to. If this is a literal string, it must be prefixed with an equals sign"
        },
        "lessThan": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be less than"
        },
        "lessThanOrEqual": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be less than or equal to"
        },
        "greaterThan": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be greater than"
        },
        "greaterThanOrEqual": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be greater than or equal to"
        },
        "in": {
          "type": [
            "null",
            "string"
          ],
          "description": "Array the property should be in"
        },
        "isEmpty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "If set, check whether the property is empty"
        },
        "maxLength": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum length of a string"
        },
        "minLength": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Minimum length of a string"
        }
      }
    },
    "EventCondition": {
      "title": "EventCondition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Id of the event to check for"
        }
      }
    },
    "Date": {
      "title": "Date",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        }
      }
    },
    "DeadlineCondition": {
      "title": "DeadlineCondition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expressionText"
      ],
      "properties": {
        "expressionText": {
          "type": "string"
        }
      }
    },
    "BilingualString": {
      "title": "BilingualString",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    }
  }
}