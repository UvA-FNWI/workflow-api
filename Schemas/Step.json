{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Step",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Internal name of the step"
    },
    "import": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Displays a step owned by a referenced instance, retaining local ordering.",
          "$ref": "#/definitions/StepImport"
        }
      ]
    },
    "title": {
      "description": "Localized title of the step as shown to user",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/BilingualString"
        }
      ]
    },
    "progress": {
      "type": "array",
      "description": "The progress information about the step",
      "items": {
        "$ref": "#/definitions/ProgressInformation"
      }
    },
    "resultsType": {
      "description": "Determines whether assessment results are shown in the step",
      "$ref": "#/definitions/StepResultsType"
    },
    "icon": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "The icon of the step",
          "$ref": "#/definitions/Icon"
        }
      ]
    },
    "template": {
      "type": [
        "null",
        "string"
      ],
      "description": "Name of a step template (Templates/Steps) to resolve this step from"
    },
    "values": {
      "type": [
        "null",
        "object"
      ],
      "description": "Parameter values passed to the resolved template",
      "additionalProperties": {}
    },
    "hierarchyMode": {
      "description": "Determines how the child steps of this step are handled",
      "$ref": "#/definitions/StepHierarchyMode"
    },
    "childrenLayout": {
      "description": "Controls how child steps appear in the parent card. Defaults to Combined.",
      "$ref": "#/definitions/StepChildrenLayout"
    },
    "children": {
      "type": "array",
      "description": "Child steps of this step",
      "items": {
        "type": "string"
      }
    },
    "condition": {
      "description": "Condition requires for this step to start",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "Condition.json"
        }
      ]
    },
    "deadline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Deadline for completing this step. Defaults to a soft deadline.",
          "$ref": "#/definitions/Deadline"
        }
      ]
    },
    "actions": {
      "type": "array",
      "description": "Actions that are possible while this step is active",
      "items": {
        "$ref": "#/definitions/Action"
      }
    },
    "ends": {
      "description": "Condition that determines when the step ends",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "$ref": "Condition.json"
        }
      ]
    },
    "mode": {
      "description": "Determines whether this is a regular, required alongside, or optional alongside step.",
      "$ref": "#/definitions/StepMode"
    },
    "before": {
      "type": [
        "null",
        "string"
      ],
      "description": "Named step that must not become current until this alongside step has ended."
    },
    "properties": {
      "type": "array",
      "description": "Properties related to this step. These will become properties of the corresponding entity",
      "items": {
        "$ref": "PropertyDefinition.json"
      }
    },
    "events": {
      "type": "array",
      "description": "Events defined within this step. These will be merged into the workflow definition's events.",
      "items": {
        "$ref": "#/definitions/EventDefinition"
      }
    }
  },
  "definitions": {
    "StepImport": {
      "title": "StepImport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "step"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "description": "Single-valued reference property pointing to the owning instance."
        },
        "step": {
          "type": "string",
          "description": "Name of the step in the referenced workflow."
        },
        "participants": {
          "type": "array",
          "description": "User properties on the referenced workflow that supply participant names.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BilingualString": {
      "title": "BilingualString",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    },
    "ProgressInformation": {
      "title": "ProgressInformation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/StatusColor"
            }
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "header": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ProgressHeader"
            }
          ]
        },
        "event": {
          "type": [
            "null",
            "string"
          ],
          "description": "Shorthand for a condition that applies when a single event is active.\n            For arbitrary logic use <see cref=\"P:UvA.Workflow.WorkflowModel.Conditions.ConditionalOption.Condition\"/> instead."
        },
        "condition": {
          "description": "Condition that determines whether this configuration applies. Takes precedence over\n            <see cref=\"P:UvA.Workflow.WorkflowModel.Conditions.ConditionalOption.Event\"/> when set. Omit both properties for an unconditional configuration.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "Condition.json"
            }
          ]
        }
      }
    },
    "StatusColor": {
      "type": "string",
      "enum": [
        "Red",
        "Green"
      ]
    },
    "ProgressHeader": {
      "title": "ProgressHeader",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/StepHeaderPillType"
        },
        "label": {
          "description": "Optional pill label. Defaults to the progress text of the enclosing entry.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        }
      }
    },
    "StepHeaderPillType": {
      "type": "string",
      "enum": [
        "Info",
        "Attention",
        "Success",
        "Error"
      ]
    },
    "StepResultsType": {
      "type": "string",
      "enum": [
        "Normal",
        "AssessmentPartOverview",
        "AssessmentFinalOverview"
      ]
    },
    "Icon": {
      "title": "Icon",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "color": {
          "$ref": "#/definitions/StatusColor"
        }
      }
    },
    "StepHierarchyMode": {
      "type": "string",
      "enum": [
        "Sequential",
        "Parallel"
      ]
    },
    "StepChildrenLayout": {
      "type": "string",
      "oneOf": [
        {
          "description": "Shows child content together in the parent card.",
          "enum": [
            "Combined"
          ]
        },
        {
          "description": "Shows each direct child in its own expandable row.",
          "enum": [
            "CollapsibleRows"
          ]
        }
      ]
    },
    "Deadline": {
      "title": "Deadline",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "description": "Expression that resolves to the deadline date."
        },
        "type": {
          "description": "Hard deadlines revoke this step's permissions except View. Separate global/form grants still apply.\n            Soft deadlines do not change permissions.",
          "$ref": "#/definitions/DeadlineType"
        },
        "text": {
          "description": "Message shown instead of the step content after a hard deadline passes. Supports bilingual text and templates.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        }
      }
    },
    "DeadlineType": {
      "type": "string",
      "enum": [
        "Soft",
        "Hard"
      ]
    },
    "Action": {
      "title": "Action",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "null",
            "string"
          ],
          "description": "Internal name of the action. Required for actions of type execute"
        },
        "label": {
          "description": "Localized label of the action as shown in the user interface",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "intent": {
          "$ref": "#/definitions/ActionIntent"
        },
        "roles": {
          "type": "array",
          "description": "List of roles that can perform this action",
          "items": {
            "type": "string"
          }
        },
        "form": {
          "type": [
            "null",
            "string"
          ],
          "description": "Target form for View / Submit / Edit actions"
        },
        "forms": {
          "type": "array",
          "description": "List of target forms for View / Submit / Edit actions",
          "items": {
            "type": "string"
          }
        },
        "collections": {
          "type": "array",
          "description": "List of target collections for ??? (not yet implemented)",
          "items": {
            "type": "string"
          }
        },
        "propertyDefinition": {
          "type": [
            "null",
            "string"
          ],
          "description": "Target propertyDefinition for the view hidden propertyDefinition action"
        },
        "workflowDefinition": {
          "type": [
            "null",
            "string"
          ]
        },
        "type": {
          "description": "Type of action",
          "$ref": "#/definitions/RoleAction"
        },
        "condition": {
          "description": "Condition that determines whether the action is permitted",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "Condition.json"
            }
          ]
        },
        "allowWhenStopped": {
          "type": "boolean",
          "description": "Allows this action while the workflow is stopped. Roles and action conditions still apply."
        },
        "onAction": {
          "type": "array",
          "description": "List of effects to run for an Execute action",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "steps": {
          "type": "array",
          "description": "List of steps during which this action is permitted",
          "items": {
            "type": "string"
          }
        },
        "persistent": {
          "type": "boolean",
          "description": "Keeps this action available on active and completed steps.\n            Roles, action conditions and applicable hard deadlines still apply. Defaults to false."
        },
        "noAutoOpenForm": {
          "type": "boolean",
          "description": "When true, the submit form does not automatically even if it is the only submit action in the step"
        },
        "property": {
          "type": [
            "null",
            "string"
          ],
          "description": "Target property for the CreateRelatedInstance action"
        },
        "userProperty": {
          "type": [
            "null",
            "string"
          ],
          "description": "Weird thing, maybe we should get rid of this?"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Weird thing, maybe we should get rid of this?"
        }
      }
    },
    "ActionIntent": {
      "type": "string",
      "enum": [
        "Primary",
        "Secondary",
        "Destructive"
      ]
    },
    "RoleAction": {
      "type": "string",
      "enum": [
        "View",
        "Submit",
        "Edit",
        "Undo",
        "ViewAdminTools",
        "Execute",
        "ViewHidden",
        "ViewUsers",
        "ViewStates",
        "Delete",
        "AddInstanceMessage",
        "ViewAnswerMessages",
        "AssignMessages",
        "CreateInstance",
        "CreateRelatedInstance",
        "ImpersonateRoles",
        "ViewResults",
        "ViewCorrespondence",
        "ViewHistory"
      ]
    },
    "Effect": {
      "title": "Effect",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional effect name, used to refer to outputs of this effect"
        },
        "condition": {
          "description": "Condition that determines if this trigger is active",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "Condition.json"
            }
          ]
        },
        "sendMail": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Send an email",
              "$ref": "#/definitions/Email"
            }
          ]
        },
        "sendAccessMail": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Prepare login access and send one personalized email per recipient",
              "$ref": "#/definitions/Email"
            }
          ]
        },
        "showConfetti": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Show confetti"
        },
        "toast": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Show a toast message",
              "$ref": "#/definitions/Toast"
            }
          ]
        },
        "http": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Do an http call to an external service",
              "$ref": "#/definitions/Http"
            }
          ]
        },
        "setProperty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Set a property on the current instance",
              "$ref": "#/definitions/SetProperty"
            }
          ]
        },
        "serviceCall": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Call an external service",
              "$ref": "#/definitions/ServiceCall"
            }
          ]
        },
        "redirect": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Redirect the user to an url",
              "$ref": "#/definitions/Redirect"
            }
          ]
        },
        "createExternalUserAccount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Create external login access for the assigned user or users of a workflow role",
              "$ref": "#/definitions/CreateExternalUserAccount"
            }
          ]
        },
        "event": {
          "type": [
            "null",
            "string"
          ],
          "description": "Complete an event"
        },
        "undoEvent": {
          "type": [
            "null",
            "string"
          ],
          "description": "Undo an event"
        },
        "delay": {
          "type": [
            "null",
            "string"
          ],
          "description": "Run the effect after this delay, e.g. 2d, 4h or 30m"
        }
      }
    },
    "Email": {
      "title": "Email",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "description": "Recipients: each entry is a property lookup (User or [User]), a literal email address, or a template.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "cc": {
          "description": "Cc recipients, resolved like 'to'.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "bcc": {
          "description": "Bcc recipients, resolved like 'to'.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "subject": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "body": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EmailContentBlock"
          }
        },
        "email": {
          "type": [
            "null",
            "string"
          ]
        },
        "layout": {
          "type": [
            "null",
            "string"
          ]
        },
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SendMessageButton"
          }
        },
        "sendAsMail": {
          "type": "boolean"
        },
        "sendAutomatically": {
          "type": "boolean"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Attachment"
          }
        }
      }
    },
    "EmailContentBlock": {
      "title": "EmailContentBlock",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "content": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "remove": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "If true, this block will be removed from the inherited email."
        },
        "after": {
          "type": [
            "null",
            "string"
          ],
          "description": "Name of another block to insert this block after."
        }
      }
    },
    "SendMessageButton": {
      "title": "SendMessageButton",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "label",
        "intent"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "label": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "intent": {
          "type": "string"
        }
      }
    },
    "Attachment": {
      "title": "Attachment",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string"
        }
      }
    },
    "Toast": {
      "title": "Toast",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "type": {
          "description": "Toast type to show in the frontend",
          "$ref": "#/definitions/ToastType"
        },
        "message": {
          "description": "Toast message to show in the frontend",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        }
      }
    },
    "ToastType": {
      "type": "string",
      "enum": [
        "Success",
        "Error",
        "Info",
        "Warning",
        "Note"
      ]
    },
    "Http": {
      "title": "Http",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "Template for the url to call"
        }
      }
    },
    "SetProperty": {
      "title": "SetProperty",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "value"
      ],
      "properties": {
        "property": {
          "type": "string",
          "description": "Target property name"
        },
        "value": {
          "type": "string",
          "description": "Expression that determines the value of the property"
        }
      }
    },
    "ServiceCall": {
      "title": "ServiceCall",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "Redirect": {
      "title": "Redirect",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "CreateExternalUserAccount": {
      "title": "CreateExternalUserAccount",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "description": "Name of the workflow role/property that holds the target user or users"
        }
      }
    },
    "StepMode": {
      "type": "string",
      "oneOf": [
        {
          "description": "Follows the ordered workflow progression. It becomes current when reached, unless its condition skips it,\n            and progression continues after it ends.",
          "enum": [
            "Normal"
          ]
        },
        {
          "description": "Becomes active after the nearest preceding normal step ends, or when the workflow starts if there is none.\n            Normal steps may continue while it remains active. It becomes current when its before target is reached or\n            when the workflow would otherwise finish, and blocks progression until it ends.",
          "enum": [
            "Alongside"
          ]
        },
        {
          "description": "Becomes active like an alongside step, but never blocks progression or becomes current. If still active when\n            the workflow finishes, it closes with the workflow.",
          "enum": [
            "Optional"
          ]
        }
      ]
    },
    "EventDefinition": {
      "title": "EventDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the event"
        },
        "label": {
          "description": "Localized label describing the event",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "suppresses": {
          "type": [
            "array",
            "null"
          ],
          "description": "List of event names that are suppressed when this event occurs. Only the most recent event will be suppressed.",
          "items": {
            "type": "string"
          }
        },
        "resetParentStep": {
          "type": "boolean",
          "description": "When declared on a step event, restarts the sequential parent of the declaring step; the suppression rules are generated from the effective hierarchy (see docs/reset-parent-step.md)."
        }
      }
    }
  }
}