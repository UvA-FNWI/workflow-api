{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Screen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Internal name of the screen"
    },
    "columns": {
      "type": "array",
      "description": "List of columns to display on this screen",
      "items": {
        "$ref": "#/definitions/Column"
      }
    },
    "grouping": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Optional grouping configuration for screen data",
          "$ref": "#/definitions/ScreenGrouping"
        }
      ]
    },
    "bulkEdit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Config for bulk editing for all instances in the screen",
          "$ref": "#/definitions/BulkEditConfig"
        }
      ]
    },
    "bulkActions": {
      "type": "array",
      "description": "Ordered buttons referencing existing instance Execute actions",
      "items": {
        "$ref": "#/definitions/BulkAction"
      }
    }
  },
  "definitions": {
    "Column": {
      "title": "Column",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "null",
            "string"
          ],
          "description": "Internal name of the column, used for inheritance"
        },
        "type": {
          "description": "Type of the column",
          "$ref": "#/definitions/ColumnType"
        },
        "filterType": {
          "description": "Determines whether this column can be used for filtering",
          "$ref": "#/definitions/FilterType"
        },
        "displayType": {
          "description": "Determines whether this column is visible in the user interface or only in the export",
          "$ref": "#/definitions/DisplayType"
        },
        "defaultSort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Sets a default sort direction for this column",
              "$ref": "#/definitions/SortDirection"
            }
          ]
        },
        "link": {
          "type": "boolean",
          "description": "If true, this column becomes a link to the instance"
        },
        "property": {
          "type": [
            "null",
            "string"
          ],
          "description": "Property this field refers to"
        },
        "value": {
          "type": [
            "null",
            "string"
          ],
          "description": "Custom value template"
        },
        "href": {
          "type": [
            "null",
            "string"
          ],
          "description": "Url the field should refer to"
        },
        "default": {
          "type": [
            "null",
            "string"
          ],
          "description": "Default value to use if the target is empty"
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "isHighlighted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "description": "Conditions that determines if the field is included in the DTO",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "Condition.json"
            }
          ]
        },
        "order": {
          "type": [
            "integer",
            "null"
          ]
        },
        "endDate": {
          "type": [
            "null",
            "string"
          ],
          "description": "Target step the field should show the end date of"
        }
      }
    },
    "ColumnType": {
      "type": "string",
      "enum": [
        "Normal",
        "CurrentStep",
        "RelatedUsers"
      ]
    },
    "FilterType": {
      "type": "string",
      "enum": [
        "None",
        "Pick"
      ]
    },
    "DisplayType": {
      "type": "string",
      "enum": [
        "Normal",
        "ExportOnly"
      ]
    },
    "SortDirection": {
      "type": "string",
      "enum": [
        "Ascending",
        "Descending"
      ]
    },
    "BilingualString": {
      "title": "BilingualString",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    },
    "ScreenGrouping": {
      "title": "ScreenGrouping",
      "type": "object",
      "description": "Configuration for grouping screen data by conditions or workflow steps",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "description": "List of screen groups in display order",
          "items": {
            "$ref": "#/definitions/StepGroup"
          }
        }
      }
    },
    "StepGroup": {
      "title": "StepGroup",
      "type": "object",
      "description": "Defines a group of workflow instances",
      "additionalProperties": false,
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Internal identifier for the group"
        },
        "title": {
          "description": "Display name of the group in nl/en",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "steps": {
          "type": "array",
          "description": "Step names that belong to this group when it has no condition",
          "items": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "order": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Optional placement of the group"
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Optional flag to enable or disable the group"
        },
        "condition": {
          "description": "Optional condition evaluated before step groups. The first matching condition wins.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "Condition.json"
            }
          ]
        }
      }
    },
    "BulkEditConfig": {
      "title": "BulkEditConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/definitions/BulkEditProperty"
        },
        "readOnlyProperties": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/BulkEditProperty"
          }
        },
        "editableProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BulkEditProperty": {
      "title": "BulkEditProperty",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property"
      ],
      "properties": {
        "property": {
          "type": "string"
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        }
      }
    },
    "BulkAction": {
      "title": "BulkAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "label",
        "icon"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "label": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "icon": {
          "$ref": "#/definitions/Icon"
        }
      }
    },
    "Icon": {
      "title": "Icon",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "color": {
          "$ref": "#/definitions/StatusColor"
        }
      }
    },
    "StatusColor": {
      "type": "string",
      "enum": [
        "Red",
        "Green"
      ]
    }
  }
}