{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Screen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Internal name of the screen"
    },
    "workflowDefinition": {
      "type": [
        "null",
        "string"
      ],
      "description": "WorkflowDefinition this screen is used for"
    },
    "columns": {
      "type": "array",
      "description": "List of columns to display on this screen",
      "items": {
        "$ref": "#/definitions/Column"
      }
    },
    "relation": {
      "type": [
        "null",
        "string"
      ],
      "description": "Relation this screen is used for"
    },
    "grouping": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Optional grouping configuration for grouping screen data by steps",
          "$ref": "#/definitions/ScreenGrouping"
        }
      ]
    }
  },
  "definitions": {
    "Column": {
      "title": "Column",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filterType": {
          "description": "Determines whether this column can be used for filtering",
          "$ref": "#/definitions/FilterType"
        },
        "displayType": {
          "description": "Determines whether this column is visible in the user interface or only in the export",
          "$ref": "#/definitions/DisplayType"
        },
        "defaultSort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Sets a default sort direction for this column",
              "$ref": "#/definitions/SortDirection"
            }
          ]
        },
        "link": {
          "type": "boolean",
          "description": "If true, this column becomes a link to the instance"
        },
        "property": {
          "type": [
            "null",
            "string"
          ],
          "description": "Property this field refers to"
        },
        "value": {
          "type": [
            "null",
            "string"
          ],
          "description": "Custom value template"
        },
        "href": {
          "type": [
            "null",
            "string"
          ],
          "description": "Url the field should refer to"
        },
        "default": {
          "type": [
            "null",
            "string"
          ],
          "description": "Default value to use if the target is empty"
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "isHighlighted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "condition": {
          "description": "Conditions that determines if the field is included in the DTO",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/Condition"
            }
          ]
        },
        "order": {
          "type": [
            "integer",
            "null"
          ]
        },
        "endDate": {
          "type": [
            "null",
            "string"
          ],
          "description": "Target step the field should show the end date of"
        },
        "currentStep": {
          "type": "boolean",
          "description": "If true, display the current step in this field"
        }
      }
    },
    "FilterType": {
      "type": "string",
      "enum": [
        "None",
        "Pick"
      ]
    },
    "DisplayType": {
      "type": "string",
      "enum": [
        "Normal",
        "ExportOnly"
      ]
    },
    "SortDirection": {
      "type": "string",
      "enum": [
        "Ascending",
        "Descending"
      ]
    },
    "BilingualString": {
      "title": "BilingualString",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    },
    "Condition": {
      "title": "Condition",
      "type": "object",
      "description": "Represents a logical condition",
      "additionalProperties": false,
      "properties": {
        "not": {
          "type": "boolean",
          "description": "If true, this condition is inverted"
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Compare property values",
              "$ref": "#/definitions/Value"
            }
          ]
        },
        "logical": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "For and/or constructs",
              "$ref": "#/definitions/Logical"
            }
          ]
        },
        "event": {
          "description": "Check if an event has occurred",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/EventCondition"
            }
          ]
        },
        "date": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Check if a date has passed",
              "$ref": "#/definitions/Date"
            }
          ]
        },
        "deadline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "description": "Check if a deadline has passed",
              "$ref": "#/definitions/Deadline"
            }
          ]
        },
        "name": {
          "type": [
            "null",
            "string"
          ],
          "description": "Use a named reusable condition"
        },
        "message": {
          "description": "Message that is shown then the condition is not, for use in form validation",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        }
      }
    },
    "Value": {
      "title": "Value",
      "type": "object",
      "description": "Represents a value comparison. Use this to compare two properties, or to compare a property to a fixed literal value\n            (prefix a string value with an equals sign to indicate a literal value)",
      "additionalProperties": false,
      "required": [
        "property"
      ],
      "properties": {
        "property": {
          "type": "string",
          "description": "Target property"
        },
        "equal": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be equal to. If this is a literal string, it must be prefixed with an equals sign"
        },
        "lessThan": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be less than"
        },
        "lessThanOrEqual": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be less than or equal to"
        },
        "greaterThan": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be greater than"
        },
        "greaterThanOrEqual": {
          "type": [
            "null",
            "string"
          ],
          "description": "Value the property should be greater than or equal to"
        },
        "in": {
          "type": [
            "null",
            "string"
          ],
          "description": "Array the property should be in"
        },
        "isEmpty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "If set, check whether the property is empty"
        },
        "maxLength": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Maximum length of a string"
        }
      }
    },
    "Logical": {
      "title": "Logical",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator": {
          "$ref": "#/definitions/LogicalOperator"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Condition"
          }
        }
      }
    },
    "LogicalOperator": {
      "type": "string",
      "enum": [
        "And",
        "Or"
      ]
    },
    "EventCondition": {
      "title": "EventCondition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Id of the event to check for"
        }
      }
    },
    "Date": {
      "title": "Date",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        }
      }
    },
    "Deadline": {
      "title": "Deadline",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expressionText"
      ],
      "properties": {
        "expressionText": {
          "type": "string"
        }
      }
    },
    "ScreenGrouping": {
      "title": "ScreenGrouping",
      "type": "object",
      "description": "Configuration for grouping screen data by workflow steps",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "description": "List of step groups",
          "items": {
            "$ref": "#/definitions/StepGroup"
          }
        }
      }
    },
    "StepGroup": {
      "title": "StepGroup",
      "type": "object",
      "description": "Defines a group of workflow steps",
      "additionalProperties": false,
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Internal identifier for the group"
        },
        "title": {
          "description": "Display name of the group in nl/en",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "steps": {
          "type": "array",
          "description": "Array of step names that belong to this group",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}