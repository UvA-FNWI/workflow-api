{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ValueSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "values": {
      "type": "array",
      "description": "Dictionary of choices within this value set",
      "items": {
        "$ref": "#/definitions/Choice"
      }
    },
    "sorting": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Determines how the choices should be sorted when shown in a selector",
          "$ref": "#/definitions/ValueSetSorting"
        }
      ]
    }
  },
  "definitions": {
    "Choice": {
      "title": "Choice",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Internal name of the choice"
        },
        "text": {
          "description": "Localized text of the choice",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "description": {
          "description": "Localized extended description text for the choice",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/BilingualString"
            }
          ]
        },
        "value": {
          "type": [
            "null",
            "number"
          ],
          "description": "Numeric value of the choice"
        },
        "condition": {
          "description": "Condition that determines if the choice should be shown",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "$ref": "Condition.json"
            }
          ]
        }
      }
    },
    "BilingualString": {
      "title": "BilingualString",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    },
    "ValueSetSorting": {
      "title": "ValueSetSorting",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "Field of the choice to sort on",
          "$ref": "#/definitions/ChoiceSortField"
        },
        "direction": {
          "description": "Direction to sort in",
          "$ref": "#/definitions/SortDirection"
        }
      }
    },
    "ChoiceSortField": {
      "type": "string",
      "enum": [
        "Name",
        "Text",
        "Value",
        "Description"
      ]
    },
    "SortDirection": {
      "type": "string",
      "enum": [
        "Ascending",
        "Descending"
      ]
    }
  }
}